# Configuração local: tem chaves em texto puro. Só o modelo sem valores entra no repositório.
.env
.env.*
!.env.example

# Modelos baixados pelo instalador (centenas de MB a GB; cada máquina baixa os seus).
modelos/

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Amostras de voz geradas para ouvir (não entram no repositório).
amostras-de-voz/

# Janela de voz: dependências e build (cada máquina instala e gera os seus).
janela/node_modules/
janela/dist/

# Aceite das licenças de terceiros: é de quem instalou nesta máquina.
.licencas-aceitas.json
# Sessões da janela (tokens do NewClaw): ficam só nesta máquina.
.sessoes-da-janela.json
.sessoes-da-janela.json.novo
# Ajustes do modelo de reconhecimento (descarregar por ociosidade): são desta máquina.
.ajustes-do-modelo.json
