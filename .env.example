# newclaw-ivox — configuração do motor de voz. O jeito simples é rodar `python instalar.py`, que pergunta e preenche.
# Vazio = recurso desligado (e o diagnóstico avisa). Nenhum modelo, voz ou idioma é escolhido pelo programa.
# Confira com:  python -m newclaw_ivox diagnostico

# Transcrição (fala → texto).
#   local = nesta máquina (Whisper, faster-whisper); url = um servidor compatível com a API OpenAI.
VOZ_STT_MOTOR=
# Local: nome do modelo do Whisper (lista: python -m newclaw_ivox modelos). Servidor: como ele chama o modelo.
VOZ_STT_MODELO=
# Só com VOZ_STT_MOTOR=url:
VOZ_STT_URL=
VOZ_STT_CHAVE=

# Síntese (texto → fala). local = nesta máquina (Kokoro); url = um servidor compatível com a API OpenAI.
VOZ_TTS_MOTOR=
VOZ_TTS_VOZ=
# Só com VOZ_TTS_MOTOR=url:
VOZ_TTS_MODELO=
VOZ_TTS_URL=
VOZ_TTS_CHAVE=

# Idioma: pt-BR, en-US ou es-ES.
VOZ_IDIOMA=

# Onde rodar: auto (usa a GPU se a medição encontrar uma), cpu ou cuda.
VOZ_DISPOSITIVO=auto

# Pasta dos modelos baixados. Vazio = a pasta "modelos" deste projeto.
VOZ_MODELOS_DIR=

# STUN/TURN, separados por vírgula (stun:..., turn:..., turns:...). Na rede local não precisa; nenhum servidor público
# é usado se você não declarar.
VOZ_ICE_SERVIDORES=

# Porta local do harness (escuta só em 127.0.0.1). Padrão: 7860.
HARNESS_PORTA=
