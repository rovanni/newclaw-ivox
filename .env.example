# newclaw-ivox — configuração do motor de voz. Copie para .env e preencha só o que você tem.
# Vazio = recurso desligado (e o diagnóstico avisa). Nenhum modelo, voz ou idioma é escolhido pelo programa.
# Confira com:  python -m newclaw_ivox diagnostico

# Transcrição (fala → texto), servidor compatível com a API OpenAI (/v1/audio/transcriptions).
# Sem URL, a janela funciona só em texto.
VOZ_STT_URL=
VOZ_STT_MODELO=
VOZ_STT_CHAVE=

# Síntese (texto → fala), servidor compatível com a API OpenAI (/v1/audio/speech). Ex.: um servidor Kokoro.
# Sem URL, as respostas aparecem só em texto.
VOZ_TTS_URL=
VOZ_TTS_MODELO=
VOZ_TTS_VOZ=
VOZ_TTS_CHAVE=

# Idioma da transcrição: pt-BR, en-US ou es-ES.
VOZ_IDIOMA=

# STUN/TURN, separados por vírgula (stun:..., turn:..., turns:...). Na rede local não precisa; nenhum servidor público
# é usado se você não declarar.
VOZ_ICE_SERVIDORES=

# Porta local do harness (escuta só em 127.0.0.1). Padrão: 7860.
HARNESS_PORTA=
